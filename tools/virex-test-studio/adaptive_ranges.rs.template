//! Isolated release-mode comparison of the actual #1869 lookup implementations.
#[path = "__PRECISE_RANGES_PATH__"]
mod candidate;
use candidate::{AdaptiveRanges, PreciseRanges};
use std::{hint::black_box, time::Instant};
const PAGE: u64 = 65536;
type Runner = fn(&[(u64, u64)], &[u64]) -> Vec<bool>;
fn next(state: &mut u64) -> u64 {
    *state ^= *state << 13;
    *state ^= *state >> 7;
    *state ^= *state << 17;
    *state
}
fn linear(ranges: &[(u64, u64)], queries: &[u64]) -> Vec<bool> {
    queries.iter().map(|&from| ranges.iter().any(|&(a,n)| a < from + PAGE && from < a.saturating_add(n))).collect()
}
fn indexed(ranges: &[(u64,u64)], queries: &[u64]) -> Vec<bool> {
    let lookup = PreciseRanges::new(ranges);
    queries.iter().map(|&from| lookup.overlaps(from,from+PAGE)).collect()
}
fn adaptive(ranges: &[(u64,u64)], queries: &[u64]) -> Vec<bool> {
    let mut lookup = AdaptiveRanges::new(ranges);
    queries.iter().map(|&from| lookup.overlaps(from,from+PAGE)).collect()
}
fn main() {
    let mut state=0x5a1d_c9e7u64;
    let runners: [Runner;3]=[linear,indexed,adaptive];
    let mut configurations=0;
    for density in [1u64,16] {
        for n in [0,1,4,8,16,64,256,1024] {
            let ranges: Vec<_>=(0..n).map(|_| (next(&mut state)%(65536*PAGE/density),next(&mut state)%(4*PAGE))).collect();
            for q in [1usize,16,32,64,256,4096] {
                let queries:Vec<_>=(0..q).map(|_| next(&mut state)%65536*PAGE).collect();
                let expected=linear(&ranges,&queries);
                assert_eq!(indexed(&ranges,&queries),expected);
                assert_eq!(adaptive(&ranges,&queries),expected);
                let hits=expected.iter().filter(|&&x|x).count();
                let repeats=(32768/q).max(8);
                let mut samples=[[0.0f64;7];3];
                for rep in 0..7 {
                    for order in 0..3 {
                        let k=(rep+order)%3;
                        let start=Instant::now();
                        for _ in 0..repeats {black_box(runners[k](black_box(&ranges),black_box(&queries)));}
                        samples[k][rep]=start.elapsed().as_secs_f64()*1e6/repeats as f64;
                    }
                }
                for series in &mut samples {series.sort_by(f64::total_cmp);}
                println!("density={density} ranges={n} queries={q} hits={hits} linear_us={:.4} indexed_us={:.4} adaptive_us={:.4}",samples[0][3],samples[1][3],samples[2][3]);
                configurations+=1;
            }
        }
    }
    println!("PASS: all {configurations} configurations matched the original; index construction included");
}
